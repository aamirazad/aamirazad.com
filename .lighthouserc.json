{
  "ci": {
    "collect": {
      "url": [
        "https://preview.aamirazad.com/",
        "https://preview.aamirazad.com/on",
        "https://preview.aamirazad.com/archive"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless --no-sandbox",
        "skipAudits": ["robots-txt"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "total-byte-weight": ["error", { "maxNumericValue": 184320 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 61440 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 35840 }],
        "unsized-images": "error",
        "uses-responsive-images": "error"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
