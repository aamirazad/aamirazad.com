{
  "name": "aamirazad-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "pnpm build && pnpm exec wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "pnpm exec wrangler types worker-configuration.d.ts",
    "deploy:preview": "pnpm build && pnpm exec wrangler deploy --env preview",
    "deploy:production": "pnpm build && pnpm exec wrangler deploy --env production"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.0",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@types/node": "24.10.9",
    "prettier": "3.9.5",
    "prettier-plugin-svelte": "3.4.1",
    "svelte": "5.56.6",
    "svelte-check": "4.4.5",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "packageManager": "pnpm@11.1.2"
}
