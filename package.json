{
  "name": "aamirazad-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/migrate.mjs --if-production && vite build",
    "check:assets": "node scripts/check-public-assets.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite build && vite preview --host 127.0.0.1 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.10.5",
    "image-size": "2.0.4",
    "oauth4webapi": "3.8.8",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "unified": "11.0.5"
  }
}
