# Leave DATABASE_URL and BLOB_READ_WRITE_TOKEN unset locally: `pnpm dev` then uses an embedded
# PGlite database in .pglite/ and an in-memory media store instead of the shared production ones.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_OWNER_SUB=
SESSION_SECRET=
# Local only: sign every localhost request in as the owner (ignored on Vercel deployments).
DEV_AUTH_BYPASS=
